# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
build/
**/build/
dist-ssr/
*.tsbuildinfo

# Test & coverage
/coverage/
backend/coverage/
frontend/coverage/
bot/coverage/
.nyc_output/
playwright-report/
test-results/
**/playwright-report/
**/test-results/
blob-report/
