backend/tmp/

# Environment & secrets (never commit real secrets)
.env
.env.*
!.env.example
!.env.docker
!.env.worker.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & editors
.DS_Store
Thumbs.db
.idea/
